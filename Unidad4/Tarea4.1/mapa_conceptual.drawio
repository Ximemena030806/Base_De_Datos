8d4;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="400" y="665" width="300" height="50" as="geometry"/></mxCell><mxCell id="n2r" value="&lt;b&gt;Regla&lt;/b&gt;&lt;br&gt;Cumple 1FN&lt;br&gt;Sin dependencias parciales:&lt;br&gt;todo atributo no primo depende&lt;br&gt;de TODA la llave candidata&lt;br&gt;&lt;br&gt;Elimina: DF parciales" style="rounded=0;html=1;multiline=1;fillColor=#d5e8d4;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="385" y="795" width="330" height="170" as="geometry"/></mxCell><mxCell id="n3" value="3FN" style="rounded=0;whiteSpace=wrap;html=1;fontStyle=1;fontSize=14;fillColor=#fff2cc;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="760" y="665" width="300" height="50" as="geometry"/></mxCell><mxCell id="n3r" value="&lt;b&gt;Regla&lt;/b&gt;&lt;br&gt;Cumple 2FN&lt;br&gt;Sin dependencias transitivas:&lt;br&gt;ningún no primo depende de otro&lt;br&gt;no primo (A-&gt;B y B-&gt;C)&lt;br&gt;&lt;br&gt;Elimina: DF transitivas" style="rounded=0;html=1;multiline=1;fillColor=#fff2cc;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="745" y="795" width="330" height="170" as="geometry"/></mxCell><mxCell id="n4" value="FNBC" style="rounded=0;whiteSpace=wrap;html=1;fontStyle=1;fontSize=14;fillColor=#ffe6cc;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="1120" y="665" width="300" height="50" as="geometry"/></mxCell><mxCell id="n4r" value="&lt;b&gt;Regla&lt;/b&gt;&lt;br&gt;Cumple 3FN&lt;br&gt;Todo determinante es&lt;br&gt;superclave: si X-&gt;Y entonces&lt;br&gt;X es llave candidata&lt;br&gt;&lt;br&gt;Elimina: determinantes no llave" style="rounded=0;html=1;multiline=1;fillColor=#ffe6cc;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="1105" y="795" width="330" height="170" as="geometry"/></mxCell><mxCell id="n5" value="4FN" style="rounded=0;whiteSpace=wrap;html=1;fontStyle=1;fontSize=14;fillColor=#e1d5e7;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="1480" y="665" width="300" height="50" as="geometry"/></mxCell><mxCell id="n5r" value="&lt;b&gt;Regla&lt;/b&gt;&lt;br&gt;Cumple FNBC&lt;br&gt;Sin dependencias multivaluadas&lt;br&gt;no triviales (X -&gt;&gt; Y), salvo&lt;br&gt;que X sea superclave&lt;br&gt;&lt;br&gt;Elimina: MVD independientes" style="rounded=0;html=1;multiline=1;fillColor=#e1d5e7;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="1465" y="795" width="330" height="170" as="geometry"/></mxCell><mxCell id="n6" value="5FN" style="rounded=0;whiteSpace=wrap;html=1;fontStyle=1;fontSize=14;fillColor=#f8cecc;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="1840" y="665" width="300" height="50" as="geometry"/></mxCell><mxCell id="n6r" value="&lt;b&gt;Regla&lt;/b&gt;&lt;br&gt;Cumple 4FN&lt;br&gt;Sin dependencias de reunión no&lt;br&gt;implicadas por las llaves&lt;br&gt;&lt;br&gt;La descomposición se&lt;br&gt;reconstruye sin pérdida" style="rounded=0;html=1;multiline=1;fillColor=#f8cecc;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="1825" y="795" width="330" height="170" as="geometry"/></mxCell><mxCell id="e0" value="exige" style="html=1;endArrow=classic;strokeColor=#333333;fontSize=11;fontStyle=2;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n1" target="n1r"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="exige" style="html=1;endArrow=classic;strokeColor=#333333;fontSize=11;fontStyle=2;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n2" target="n2r"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="exige" style="html=1;endArrow=classic;strokeColor=#333333;fontSize=11;fontStyle=2;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n3" target="n3r"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="exige" style="html=1;endArrow=classic;strokeColor=#333333;fontSize=11;fontStyle=2;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n4" target="n4r"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="exi
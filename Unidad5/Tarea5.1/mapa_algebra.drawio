<mxfile host="app.diagrams.net"><diagram id="alg" name="Mapa conceptual"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="800" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="root" value="ÁLGEBRA RELACIONAL" style="ellipse;whiteSpace=wrap;html=1;fillColor=#aec6ec;strokeColor=#1F3F7A;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="900" y="8" width="360" height="44" as="geometry"/></mxCell><mxCell id="cu" value="una relación como entrada" style="whiteSpace=wrap;html=1;fillColor=none;dashed=1;dashPattern=8 4;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="30" y="150" width="490" height="460" as="geometry"/></mxCell><mxCell id="cb" value="dos relaciones como entrada" style="whiteSpace=wrap;html=1;fillColor=none;dashed=1;dashPattern=8 4;strokeColor=#82b366;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="560" y="150" width="930" height="460" as="geometry"/></mxCell><mxCell id="cx" value="álgebra relacional extendida" style="whiteSpace=wrap;html=1;fillColor=none;dashed=1;dashPattern=8 4;strokeColor=#b85450;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1530" y="150" width="490" height="530" as="geometry"/></mxCell><mxCell id="u0" value="&lt;b&gt;σ  Selección&lt;/b&gt;&lt;br&gt;σ_p(R) = { t ∈ R | p(t) }&lt;br&gt;Filtra FILAS: las que cumplen la condición p&lt;br&gt;El esquema no cambia" style="rounded=0;html=1;multiline=1;fillColor=#dae8fc;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="50" y="215" width="450" height="110" as="geometry"/></mxCell><mxCell id="u1" value="&lt;b&gt;π  Proyección&lt;/b&gt;&lt;br&gt;π_A1,…,An(R)&lt;br&gt;Conserva solo las COLUMNAS indicadas&lt;br&gt;Elimina tuplas duplicadas" style="rounded=0;html=1;multiline=1;fillColor=#dae8fc;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="50" y="350" width="450" height="110" as="geometry"/></mxCell><mxCell id="u2" value="&lt;b&gt;ρ  Renombramiento&lt;/b&gt;&lt;br&gt;ρ_S(A1,…,An)(R)&lt;br&gt;Cambia el nombre de la relación o de&lt;br&gt;atributos; resuelve conflictos de nombres" style="rounded=0;html=1;multiline=1;fillColor=#dae8fc;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="50" y="485" width="450" height="110" as="geometry"/></mxCell><mxCell id="b0" value="&lt;b&gt;×  Producto cartesiano&lt;/b&gt;&lt;br&gt;R × S = { t·u | t ∈ R, u ∈ S }&lt;br&gt;Todas las combinaciones de filas&lt;br&gt;|R|·|S| tuplas; atributos disjuntos" style="rounded=0;html=1;multiline=1;fillColor=#d5e8d4;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="570" y="215" width="440" height="110" as="geometry"/></mxCell><mxCell id="b1" value="&lt;b&gt;∪  Unión&lt;/b&gt;&lt;br&gt;R ∪ S = { t | t ∈ R  ó  t ∈ S }&lt;br&gt;Filas de R, de S o de ambas&lt;br&gt;Exige compatibilidad de unión" style="rounded=0;html=1;multiline=1;fillColor=#d5e8d4;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="1030" y="215" width="440" height="110" as="geometry"/></mxCell><mxCell id="b2" value="&lt;b&gt;∩  Intersección&lt;/b&gt;&lt;br&gt;R ∩ S = R − (R − S)&lt;br&gt;Filas presentes en R y en S&lt;br&gt;Exige compatibilidad de unión" style="rounded=0;html=1;multiline=1;fillColor=#d5e8d4;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="570" y="350" width="440" height="110" as="geometry"/></mxCell><mxCell id="b3" value="&lt;b&gt;−  Diferencia&lt;/b&gt;&lt;br&gt;R − S = { t ∈ R | t ∉ S }&lt;br&gt;Filas de R que no están en S&lt;br&gt;No es conmutativa" style="rounded=0;html=1;multiline=1;fillColor=#d5e8d4;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="1030" y="350" width="440" height="110" as="geometry"/></mxCell><mxCell id="b4" value="&lt;b&gt;÷  División&lt;/b&gt;&lt;br&gt;R(X∪Y) ÷ S(Y) = { x | ∀y∈S: (x,y)∈R }&lt;br&gt;Valores de X relacionados con TODO S&lt;br&gt;= π_X(R) − π_X((π_X(R) × S) − R)" style="rounded=0;html=1;multiline=1;fillColor=#d5e8d4;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="570" y="485" width="440" height="110" as="geometry"/></mxCell><mxCell id="b5" value="&lt;b&gt;⋈  Reunión (join)&lt;/b&gt;&lt;br&gt;R ⋈_θ S = σ_θ(R × S)&lt;br&gt;Natural: iguala atributos comunes&lt;br&gt;θ-join y equijoin: condición θ" style="rounded=0;html=1;multiline=1;fillColor=#d5e8d4;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="1030" y="485" width="440" height="110" as="geometry"/></mxCell><mxCell id="x0" value="&lt;b&gt;π  Proyección generalizada&lt;/b&gt;&lt;br&gt;π_F1,…,Fn(R)&lt;br&gt;Proyecta expresiones, p. ej.&lt;br&gt;existencia × precio → valor" style="rounded=0;html=1;multiline=1;fillColor=#f8cecc;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="1550" y="183" width="450" height="105" as="geometry"/></mxCell><mxCell id="x1" value="&lt;b&gt;G  Agregación&lt;/b&gt;&lt;br&gt;_A G_f(B)(R)&lt;br&gt;Agrupa por A y calcula&lt;br&gt;count, sum, avg, min, max" style="rounded=0;html=1;multiline=1;fillColor=#f8cecc;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="1550" y="308" width="450" height="105" as="geometry"/></mxCell><mxCell id="x2" value="&lt;b&gt;⋈_L  ⋈_R  Reunión externa izq./der.&lt;/b&gt;&lt;br&gt;R ⋈_L S ;  R ⋈_R S&lt;br&gt;Conserva las filas sin pareja del lado&lt;br&gt;indicado y las completa con NULL" style="rounded=0;html=1;multiline=1;fillColor=#f8cecc;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="1550" y="433" width="450" height="105" as="geometry"/></mxCell><mxCell id="x3" value="&lt;b&gt;⋈_F  Reunión externa completa&lt;/b&gt;&lt;br&gt;R ⋈_F S&lt;br&gt;Conserva las filas sin pareja de ambos&lt;br&gt;lados y las completa con NULL" style="rounded=0;html=1;multiline=1;fillColor=#f8cecc;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="1550" y="558" width="450" height="105" as="geometry"/></mxCell><mxCell id="kcu" value="Unarios" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="165" y="80" width="220" height="36" as="geometry"/></mxCell><mxCell id="kcb" value="Binarios" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="910" y="80" width="220" height="36" as="geometry"/></mxCell><mxCell id="kcx" value="Extendidos" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1665" y="80" width="220" height="36" as="geometry"/></mxCell><mxCell id="e0" value="se clasifican en" style="html=1;endArrow=classic;strokeColor=#333333;fontSize=11;fontStyle=2;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="root" target="kcu"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="" style="html=1;endArrow=classic;strokeColor=#333333;fontSize=11;fontStyle=2;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="kcu" target="cu"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="" style="html=1;endArrow=classic;strokeColor=#333333;fontSize=11;fontStyle=2;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="root" target="kcb"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="" style="html=1;endArrow=classic;strokeColor=#333333;fontSize=11;fontStyle=2;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="kcb" target="cb"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="" style="html=1;endArrow=classic;strokeColor=#333333;fontSize=11;fontStyle=2;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="root" target="kcx"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="" style="html=1;endArrow=classic;strokeColor=#333333;fontSize=11;fontStyle=2;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="kcx" target="cx"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="title" value="Mapa conceptual: operadores del álgebra relacional" style="text;html=1;fontSize=22;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="8" width="760" height="36" as="geometry"/></mxCell><mxCell id="nota" value="Notación: R y S son relaciones; p, θ son condiciones; A, B son atributos; X, Y son conjuntos de atributos; t y u son tuplas." style="text;html=1;fontSize=12;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="30" y="640" width="1300" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>